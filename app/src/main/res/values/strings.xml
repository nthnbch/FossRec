    <string name="settings">Settings</string>
    <string name="back">Back</string>
    <string name="settings_section_recording">Recording</string>
    <string name="settings_format_title">Format</string>
    <string name="settings_format_body">M4A (AAC, 192 kbps, 44.1 kHz). Plays everywhere and works with most speech-to-text tools.</string>
    <string name="settings_split_intro">Long recordings can be cut automatically into several files. The recording never stops: the next part starts right away, and the parts stay linked in your list.</string>
    <string name="settings_split_size_title">Split by file size</string>
    <string name="settings_split_size_body">Start a new part when a file reaches this size. Useful for tools limited to 100 MB.</string>
    <string name="settings_split_duration_title">Split by duration</string>
    <string name="settings_split_duration_body">Start a new part at a regular interval.</string>
    <string name="settings_unit_mb">%1$d MB</string>
    <string name="settings_unit_min">%1$d min</string>
    <string name="settings_size_estimate">About %1$d min of audio per part</string>
    <string name="settings_split_note">If both are enabled, the first limit reached applies.</string>
    <string name="settings_section_security">Security &amp; privacy</string>
    <string name="settings_lock_title">Fingerprint lock</string>
    <string name="settings_lock_body">FossRec is locked by your fingerprint, face or screen lock whenever one is set up on your phone. It locks again each time you leave the app.</string>
    <string name="settings_local_title">100 % local</string>
    <string name="settings_local_body">No internet permission, no account, no tracking. Recordings stay in the app\'s private storage on your device.</string>
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_dark_title">Automatic dark mode</string>
    <string name="settings_dark_body">FossRec follows your phone\'s light or dark theme, and uses your wallpaper colors on Android 12 and later.</string>
    <string name="settings_section_tips">Tips</string>
    <string name="settings_refresh_title">List refresh</string>
    <string name="settings_refresh_body">When you stop a recording, the list refreshes by itself and the new recording appears at the top.</string>
    <string name="settings_swipe_title">Swipe to delete</string>
    <string name="settings_swipe_body">Swipe a recording left or right to delete it. You always get a confirmation first.</string>
    <string name="settings_widget_title">Home-screen widget</string>
    <string name="settings_widget_body">Add the FossRec widget from your launcher to start and stop a recording in one tap.</string>
    <string name="settings_section_legal">Legal</string>
    <string name="settings_legal_title">Recording and consent</string>
    <string name="settings_legal_body">Recording people without their consent is illegal in many countries. Tap to read the full notice.</string>
